<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="roommount.RoomMount" prefWidth="540" prefHeight="580">
    <padding>
        <Insets top="10" right="12" bottom="10" left="12"/>
    </padding>
    <top>
        <VBox spacing="8">
            <Label text="Room Backup" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="statusLbl" text="Waiting for connection…"/>
            <Label fx:id="helpLbl" text="Chat: :msave · :mload · :mdel · :mlist · :mstop · :mhelp" style="-fx-text-fill: #555555;"/>
            <HBox spacing="8">
                <Label text="Snapshot"/>
                <TextField fx:id="nameField" prefWidth="180" promptText="name"/>
                <Button fx:id="saveBtn" text="Save" onAction="#onSave"/>
                <Button fx:id="mountBtn" text="Mount" onAction="#onMount"/>
                <Button fx:id="deleteBtn" text="Delete" onAction="#onDelete"/>
                <Button fx:id="stopBtn" text="Stop" onAction="#onStop"/>
                <Button fx:id="refreshBtn" text="Refresh" onAction="#onRefresh"/>
            </HBox>
            <HBox spacing="12">
                <CheckBox fx:id="gameChatCbx" text="In-game messages" selected="true"/>
                <CheckBox fx:id="onTopCbx" text="Always on top" onAction="#onAlwaysOnTop"/>
                <CheckBox fx:id="forceCbx" text="Force remount"/>
            </HBox>
            <HBox spacing="12">
                <Label text="Missing"/>
                <ChoiceBox fx:id="missingChoice"/>
                <Label text="Source"/>
                <ChoiceBox fx:id="sourceChoice"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Delay"/>
                <Slider fx:id="delaySlider" min="40" max="1500" value="320" prefWidth="220" blockIncrement="20" majorTickUnit="365" minorTickCount="3" showTickMarks="true"/>
                <Label fx:id="delayLbl" text="320 ms"/>
            </HBox>
            <ListView fx:id="snapshotList" prefHeight="120"/>
        </VBox>
    </top>
    <center>
        <TextArea fx:id="logArea" editable="false" wrapText="true"/>
    </center>
</BorderPane>
